---
import { getCollection } from "astro:content";
import { BLOG_CATEGORIES, PRODUCT_CATEGORIES, WA_MESSAGES, waUrl } from "@config/site";
import { tagLabel } from "@config/tags";
import { navIcon } from "@config/nav-icons";
import { anchorText, PRIORIDAD_ENLACES } from "@config/anchors";
import { MEDICION_CONDICION, PRECIOS_REFERENCIA, formatearPrecio, precioMasBajo } from "@config/precios";
import { minutosLectura } from "@lib/lectura";

interface Props {
  currentSlug?: string;
  currentCategory?: string;
  currentTags?: string[];
  ctaHeading?: string;
  waMessage?: string;
}

const { currentSlug, currentCategory, currentTags = [], ctaHeading = "¿Te quedó una duda?", waMessage = WA_MESSAGES.blog } = Astro.props;
const publicados = (await getCollection("articulos", ({ data }) => data.draft !== true)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recientes = publicados.filter((post) => post.id !== currentSlug).slice(0, 4);
const categorias = BLOG_CATEGORIES.map((categoria) => ({ ...categoria, count: publicados.filter((post) => post.data.category === categoria.slug).length })).filter((categoria) => categoria.count > 0);
const tagCount = new Map<string, number>();
for (const post of publicados) {
  for (const tag of post.data.tags ?? []) tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "es")).slice(0, 12).map(([tag]) => tag);
const catalogo = PRODUCT_CATEGORIES.flatMap((categoria) => {
  const precio = PRECIOS_REFERENCIA[categoria.slug as keyof typeof PRECIOS_REFERENCIA];
  const referencia = precio?.ventana ?? precio?.puerta;
  return referencia === undefined || referencia === null ? [] : [{ ...categoria, precio: referencia }];
});
// Orden por volumen de búsqueda (Ahrefs): primero las categorías con más demanda.
const rango = (href: string) => { const i = (PRIORIDAD_ENLACES as readonly string[]).indexOf(href); return i === -1 ? 99 : i; };
catalogo.sort((a, b) => rango(a.href) - rango(b.href));
const waLink = waUrl(waMessage);
const fmtCorta = (fecha: Date) => fecha.toLocaleDateString("es-MX", { day: "numeric", month: "short", timeZone: "UTC" });
---

<aside class="bsb" aria-label="Barra lateral del blog">
  <section class="bsb__w bsb__w--cta tone-dark" aria-labelledby="bsb-cta">
    <h2 class="bsb__title" id="bsb-cta">{ctaHeading}</h2>
    <p class="bsb__cta-desc">Mándanos una foto de tu ventana y las medidas. Te decimos qué tipo de mosquitero corresponde y te pasamos el precio por pieza.</p>
    <dl class="bsb__facts">
      <div><dt>Ventana</dt><dd>desde {formatearPrecio(precioMasBajo("ventana"))}</dd></div>
      <div><dt>Puerta</dt><dd>desde {formatearPrecio(precioMasBajo("puerta"))}</dd></div>
      <div><dt>Medición</dt><dd>{MEDICION_CONDICION}</dd></div>
    </dl>
    <a class="bsb__btn" href={waLink} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
  </section>

  {categorias.length > 0 && <section class="bsb__w" aria-labelledby="bsb-cats">
    <h2 class="bsb__title" id="bsb-cats">Categorías</h2>
    <ul class="bsb__list" role="list">
      {categorias.map((categoria) => <li><a class:list={["bsb__cat", { "is-active": categoria.slug === currentCategory }]} href={`/blog/categoria/${categoria.slug}/`} aria-current={categoria.slug === currentCategory ? "page" : undefined}><span>{categoria.label}</span><span class="bsb__count">{categoria.count}</span></a></li>)}
    </ul>
  </section>}

  {recientes.length > 0 && <section class="bsb__w" aria-labelledby="bsb-recientes">
    <h2 class="bsb__title" id="bsb-recientes">Artículos recientes</h2>
    <ul class="bsb__list bsb__list--posts" role="list">
      {recientes.map((post) => <li><a class="bsb__post" href={`/blog/${post.id}/`}><img class="bsb__thumb" src={post.data.heroImage} alt="" width="64" height="64" loading="lazy" decoding="async" /><span class="bsb__post-body"><span class="bsb__post-title">{post.data.title}</span><span class="bsb__post-meta"><time datetime={post.data.pubDate.toISOString()}>{fmtCorta(post.data.pubDate)}</time><span aria-hidden="true">·</span><span>{minutosLectura(post.body)} min</span></span></span></a></li>)}
    </ul>
  </section>}

  <section class="bsb__w" aria-labelledby="bsb-catalogo">
    <h2 class="bsb__title" id="bsb-catalogo">Tipos de mosquitero</h2>
    <ul class="bsb__list" role="list">
      {catalogo.map((categoria) => <li><a class="bsb__link-icon" href={categoria.href}><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={navIcon(categoria.icon)} /><span>{anchorText(categoria.href)}</span><span class="bsb__price">desde {formatearPrecio(categoria.precio)}</span></a></li>)}
    </ul>
  </section>

  {tags.length > 0 && <section class="bsb__w" aria-labelledby="bsb-tags">
    <h2 class="bsb__title" id="bsb-tags">Temas</h2>
    <ul class="bsb__tags" role="list">
      {tags.map((tag) => <li><a class:list={["bsb__tag", { "is-active": currentTags.includes(tag) }]} href={`/blog/tag/${tag}/`}>{tagLabel(tag)}</a></li>)}
    </ul>
  </section>}
</aside>

<style>
  .bsb {
    display: grid;
    gap: var(--sp-8);
    align-content: start;
  }
  .bsb__w {
    padding-top: var(--sp-3);
    border-top: 2px solid var(--c-ink);
  }
  .bsb__w--cta {
    padding: var(--sp-6);
    border-top: 0;
  }
  .bsb__title {
    margin: 0 0 var(--sp-4);
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bsb__list {
    display: grid;
    gap: var(--sp-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bsb__cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-height: 44px;
    color: var(--c-ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .bsb__cat:hover,
  .bsb__cat.is-active {
    color: var(--c-primary);
  }
  .bsb__cat.is-active {
    font-weight: var(--weight-semibold);
  }
  .bsb__count,
  .bsb__price {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .bsb__list--posts {
    gap: var(--sp-4);
  }
  .bsb__post {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    color: var(--c-ink);
    text-decoration: none;
  }
  .bsb__thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    object-fit: cover;
  }
  .bsb__post-body {
    display: grid;
    gap: var(--sp-1);
  }
  .bsb__post-title {
    color: var(--c-ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }
  .bsb__post:hover .bsb__post-title {
    color: var(--c-primary);
  }
  .bsb__post-meta {
    display: flex;
    gap: var(--sp-2);
    color: var(--c-muted);
    font-size: var(--text-xs);
  }
  .bsb__facts {
    display: grid;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-5);
  }
  .bsb__facts div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--c-border);
    font-size: var(--text-sm);
  }
  .bsb__facts dt {
    color: var(--c-muted);
  }
  .bsb__facts dd {
    margin: 0;
    color: var(--c-ink);
    font-weight: var(--weight-semibold);
    text-align: right;
  }
  .bsb__cta-desc {
    margin: 0 0 var(--sp-5);
    color: var(--c-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .bsb__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-accent);
    color: var(--c-primary);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--transition-btn), color var(--transition-btn);
  }
  .bsb__btn:hover {
    background: var(--c-on-dark);
    color: var(--c-primary);
  }
  .bsb__link-icon {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--sp-2);
    align-items: center;
    min-height: 44px;
    color: var(--c-ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .bsb__link-icon svg,
  .bsb__link-icon:hover {
    color: var(--c-primary);
  }
  .bsb__price {
    color: var(--c-muted);
    text-align: right;
  }
  .bsb__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bsb__tag {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: var(--sp-1) var(--sp-2);
    border: 1px solid var(--c-border);
    color: var(--c-muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }
  .bsb__tag:hover {
    border-color: var(--c-primary);
    color: var(--c-primary);
  }
  .bsb__tag.is-active {
    background: var(--c-primary);
    border-color: var(--c-primary);
    color: var(--c-on-dark);
  }
  .bsb a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }
  .bsb__w--cta a:focus-visible {
    outline-color: var(--c-accent);
  }
</style>
