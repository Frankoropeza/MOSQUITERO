---
// ============================================================================
// blog/tag/[tag].astro — ARCHIVO POR TAG (L3). Ruta: /blog/tag/<tag>
// ----------------------------------------------------------------------------
// Cierra el otro enlace que el artículo ya exportaba y que no tenía destino.
//
// TAG ≠ CATEGORÍA (y por qué se tratan distinto):
//   • La categoría es un enum CERRADO (Zod la valida) → es taxonomía: pocas,
//     estables, indexables, con página propia que merece posicionar.
//   • El tag es string libre (máx. 10 por artículo) → es etiqueta: muchas,
//     efímeras, se solapan entre sí. Cada tag genera una página con casi los
//     mismos artículos que la categoría: contenido duplicado a ojos de Google.
//
// DECISIÓN DE FRANK (2026-09-28): todo el sitio es index,follow, incluidos los
// tags. El riesgo de contenido fino se mitiga con título y descripción únicos,
// más el listado explícito de artículos que convierte cada archivo en una
// CollectionPage útil, en vez de una taxonomía vacía o duplicada sin contexto.
// ============================================================================
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BlogCard from "@components/BlogCard.astro";
import BlogSidebar from "@components/BlogSidebar.astro";
import BlogCategoryNav from "@components/BlogCategoryNav.astro";
import BlogPager from "@components/BlogPager.astro";
import CTABanner from "@components/CTABanner.astro";
import { WA_MESSAGES, blogCategoryLabel, waUrl } from "@config/site";
import { tagLabel } from "@config/tags";
import { minutosLectura } from "@lib/lectura";

export const getStaticPaths = (async ({ paginate }) => {
  // Mismo orden que /blog (ver la nota en blog/[...page].astro).
  const posts = (await getCollection("articulos", ({ data }) => data.draft !== true)).sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
      a.data.title.localeCompare(b.data.title, "es"),
  );

  // Set: un tag repetido en 3 artículos genera UNA ruta, no tres. Sin esto,
  // getStaticPaths devuelve params duplicados y Astro falla el build.
  const tags = new Set(posts.flatMap((p) => p.data.tags ?? []));

  return [...tags].flatMap((tag) => paginate(posts.filter((post) => (post.data.tags ?? []).includes(tag)), {
    params: { tag },
    props: { tag },
    pageSize: 9,
  }));
}) satisfies GetStaticPaths;

interface Props { tag: string; page: Page<CollectionEntry<"articulos">>; }
const { tag, page } = Astro.props;
const posts = page.data;
const esPrimera = page.currentPage === 1;
const label = tagLabel(tag);
const labelMin = label === "CDMX" ? label : label.toLowerCase();

const title = esPrimera ? `${label} | blog de Mosquitero.mx` : `${label} — página ${page.currentPage} | blog de Mosquitero.mx`;
const description = esPrimera
  ? `${page.total === 1 ? "Artículo" : "Artículos"} del blog de Mosquitero.mx sobre ${labelMin}: guías para elegir, medir, instalar y mantener mosquiteros a medida.`
  : `Página ${page.currentPage} de ${page.lastPage} de artículos sobre ${labelMin}: consulta guías prácticas para elegir, medir, instalar y mantener mosquiteros a medida.`;

const schemaData = {
  list: {
    name: `${label} — blog de Mosquitero.mx`,
    description,
    path: page.url.current,
    items: posts.map((post) => ({
      name: post.data.title,
      path: `/blog/${post.id}/`,
      image: post.data.heroImage,
      description: post.data.description,
    })),
  },
};

const breadcrumbs = esPrimera ? [{ label: "Blog", href: "/blog/" }, { label }] : [{ label: "Blog", href: "/blog/" }, { label, href: `/blog/tag/${tag}/` }, { label: `Página ${page.currentPage}` }];
---

<PageLayout
  title={title}
  description={description}
  pageType="directory"
  schemaData={schemaData}
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <div class="container">
      {/* as="h1": la página no tiene Hero, así que este encabezado es el título
          del documento (ver la nota del contrato en SectionHeading.astro). */}
      <SectionHeading
        as="h1"
        eyebrow="Tema"
        title={label}
        body={[
          `Todo lo que hemos escrito sobre ${labelMin}. Los temas cruzan las categorías del blog: un mismo artículo puede resolver una duda de medición y otra de mantenimiento.`,
          "Si buscas algo más concreto, el índice del blog está ordenado por categoría — o escríbenos y te decimos directamente qué aplica a tu ventana.",
        ]}
      />

      <BlogCategoryNav />

      <div class="blog">
        <div class="blog__main">
          <h2 class="blog__title">{posts.length === 1 ? "1 artículo" : `${posts.length} artículos`} · página {page.currentPage} de {page.lastPage}</h2>
          <div class="blog__list">
            {posts.map((post, i) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}/`}
                image={post.data.heroImage}
                imageAlt={post.data.title}
                category={post.data.category}
                categoryLabel={blogCategoryLabel(post.data.category)}
                pubDate={post.data.pubDate}
                variant="row"
                minutos={minutosLectura(post.body)}
                index={i}
              />
            ))}
          </div>

          <BlogPager currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={`/blog/tag/${tag}/`} prevUrl={page.url.prev} nextUrl={page.url.next} articleCount={page.total} />

          <p class="blog__back">
            <a href="/blog/">← Todos los artículos</a>
          </p>
        </div>

        <BlogSidebar
          currentTags={[tag]}
          ctaHeading="¿Prefieres preguntarnos?"
          waMessage={WA_MESSAGES.blog}
        />
      </div>
    </div>
  </section>

  <CTABanner
    heading="¿Ya sabes qué mosquitero necesitas?"
    desc="Mándanos las medidas de tus ventanas por WhatsApp y te pasamos el precio por pieza, con el tipo de mosquitero y la malla que te convienen."
    btns={[
      { label: "Cotizar por WhatsApp", href: waUrl(WA_MESSAGES.cotizar), icon: "wa", primary: true, external: true },
    ]}
    variant="dark"
    centered={true}
  />
</PageLayout>

<style>

  .blog {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-8);
  }
  .blog__main {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
  .blog__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    color: var(--c-ink);
  }
  .blog__list {
    display: grid;
    gap: 0;
  }

  .blog__back {
    margin: 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--c-border);
  }
  .blog__back a {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--c-primary);
    text-decoration: none;
  }
  .blog__back a:hover {
    text-decoration: underline;
  }
  .blog__back a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
  @media (min-width: 1024px) {
    .blog {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--sp-10);
    }
    .blog > :global(.bsb) {
      position: sticky;
      top: calc(var(--header-height) + var(--sp-4));
    }
  }
</style>
