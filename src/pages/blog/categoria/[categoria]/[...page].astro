---
// ============================================================================
// blog/categoria/[categoria].astro — ARCHIVO POR CATEGORÍA (L3). /blog/categoria/<slug>
// ----------------------------------------------------------------------------
// Es la página que ya enlazaban el chip de categoría del artículo y el sidebar.
// Antes de esta ruta, esos enlaces eran 404 — es decir, cada artículo publicado
// exportaba un enlace roto al rastreador.
//
// SOLO SE GENERAN LAS CATEGORÍAS CON ARTÍCULOS. El enum de content.config.ts
// tiene 5 (guias, mantenimiento, tipos-de-malla, novedades, general); si tres
// están vacías, generarlas produce tres páginas en blanco que Google clasifica
// como thin content y que arrastran la calidad percibida del dominio. Cuando se
// publique el primer artículo de esa categoría, la ruta aparece sola.
//
// Cada categoría se pagina a partir de 9 artículos para que el archivo conserve
// una lectura escaneable conforme crezca la colección.
// ============================================================================
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BlogCard from "@components/BlogCard.astro";
import BlogSidebar from "@components/BlogSidebar.astro";
import BlogCategoryNav from "@components/BlogCategoryNav.astro";
import BlogPager from "@components/BlogPager.astro";
import CTABanner from "@components/CTABanner.astro";
import { BLOG_CATEGORIES, WA_MESSAGES, waUrl } from "@config/site";
import { minutosLectura } from "@lib/lectura";

export const getStaticPaths = (async ({ paginate }) => {
  // Mismo orden que /blog: destacado, fecha descendente y título alfabético.
  const posts = (await getCollection("articulos", ({ data }) => data.draft !== true)).sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
      a.data.title.localeCompare(b.data.title, "es"),
  );

  return BLOG_CATEGORIES.flatMap((cat) => {
    const categoryPosts = posts.filter((post) => post.data.category === cat.slug);
    return categoryPosts.length === 0 ? [] : paginate(categoryPosts, {
      params: { categoria: cat.slug },
      props: { cat },
      pageSize: 9,
    });
  });
}) satisfies GetStaticPaths;

interface Props { cat: (typeof BLOG_CATEGORIES)[number]; page: Page<CollectionEntry<"articulos">>; }
const { cat, page } = Astro.props;
const posts = page.data;
const esPrimera = page.currentPage === 1;

// ── Metas ──
// El title abre con la keyword de la categoría, sin marca (regla de metas).
const title = esPrimera ? `${cat.label} de mosquiteros | blog de Mosquitero.mx` : `${cat.label} de mosquiteros — página ${page.currentPage} | blog de Mosquitero.mx`;
const description = esPrimera ? `${cat.desc} ${page.total === 1 ? "1 artículo" : `${page.total} artículos`} sobre mosquiteros a medida, fabricación e instalación.` : `Página ${page.currentPage} de ${page.lastPage}: ${cat.desc}`;

const schemaData = {
  list: {
    name: `${cat.label} — blog de Mosquitero.mx`,
    description: cat.desc,
    path: page.url.current,
    items: posts.map((post) => ({
      name: post.data.title,
      path: `/blog/${post.id}/`,
      image: post.data.heroImage,
      description: post.data.description,
    })),
  },
};

const breadcrumbs = esPrimera ? [{ label: "Blog", href: "/blog/" }, { label: cat.label }] : [{ label: "Blog", href: "/blog/" }, { label: cat.label, href: `/blog/categoria/${cat.slug}/` }, { label: `Página ${page.currentPage}` }];
---

<PageLayout
  title={title}
  description={description}
  pageType="directory"
  schemaData={schemaData}
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <div class="container">
      {/* as="h1": la página no tiene Hero, así que este encabezado es el título
          del documento (ver la nota del contrato en SectionHeading.astro). */}
      <SectionHeading
        as="h1"
        eyebrow="Categoría"
        title={cat.label}
        body={[
          cat.desc,
          "Si después de leer sigues con la duda, mándanos una foto de tu ventana por WhatsApp: con verla sabemos qué corresponde y te evitamos comprar la pieza equivocada.",
        ]}
      />

      <BlogCategoryNav current={cat.slug} />

      <div class="blog">
        <div class="blog__main">
          <h2 class="blog__title">{posts.length === 1 ? "1 artículo" : `${posts.length} artículos`} · página {page.currentPage} de {page.lastPage}</h2>
          <div class="blog__list">
            {posts.map((post, i) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}/`}
                image={post.data.heroImage}
                imageAlt={post.data.title}
                category={post.data.category}
                categoryLabel={cat.label}
                pubDate={post.data.pubDate}
                variant="row"
                minutos={minutosLectura(post.body)}
                index={i}
              />
            ))}
          </div>

          <BlogPager currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={`/blog/categoria/${cat.slug}/`} prevUrl={page.url.prev} nextUrl={page.url.next} articleCount={page.total} />

          <p class="blog__back">
            <a href="/blog/">← Todos los artículos</a>
          </p>
        </div>

        <BlogSidebar
          currentCategory={cat.slug}
          ctaHeading="¿Prefieres preguntarnos?"
          waMessage={WA_MESSAGES.blog}
        />
      </div>
    </div>
  </section>

  <CTABanner
    heading="¿Ya sabes qué mosquitero necesitas?"
    desc="Mándanos las medidas de tus ventanas por WhatsApp y te pasamos el precio por pieza, con el tipo de mosquitero y la malla que te convienen."
    btns={[
      { label: "Cotizar por WhatsApp", href: waUrl(WA_MESSAGES.cotizar), icon: "wa", primary: true, external: true },
    ]}
    variant="dark"
    centered={true}
  />
</PageLayout>

<style>

  .blog {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-top: var(--sp-8);
  }
  .blog__main {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
  .blog__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    color: var(--c-ink);
  }
  .blog__list {
    display: grid;
    gap: 0;
  }

  .blog__back {
    margin: 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--c-border);
  }
  .blog__back a {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--c-primary);
    text-decoration: none;
  }
  .blog__back a:hover {
    text-decoration: underline;
  }
  .blog__back a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
  @media (min-width: 1024px) {
    .blog {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--sp-10);
    }
    .blog > :global(.bsb) {
      position: sticky;
      top: calc(var(--header-height) + var(--sp-4));
    }
  }
</style>
