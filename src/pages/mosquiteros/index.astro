---
// ============================================================================
// mosquiteros/index.astro — MOSQUITEROS · TIPOS Y COMPARATIVA (L2).
// ----------------------------------------------------------------------------
// HOMOLOGADA A LA HOME. Mismo ritmo de secciones, mismos componentes, mismas
// reglas. Si cambias el patrón aquí, revisa index.astro — y al revés:
//     1) Hero            → H1 único con la propuesta + kw
//     2) SectionMenu     → barra full-width bajo el hero
//     3) Catálogo        → CategoryCard, seis tipos + accesorios
//     4) Comparativa     → apertura, caso de uso y precio de referencia
//     5) A fondo         → CategoryDetail por tipo (as="h3", cuelga del H2)
//     6) Qué incluye     → cuatro constantes del trabajo
//     7) FAQ + QuoteForm → dos columnas, misma estructura que la home
//     8) SectionMenu     → menú de guías antes del footer
//
// QUÉ LA DIFERENCIA DE LA HOME, Y POR QUÉ EXISTE
// La home PRESENTA: 4 tipos, blurb corto, empuja a WhatsApp. Esta L2 es el
// CATÁLOGO: los 7 tipos, cada uno a fondo, y —lo que de verdad justifica la
// página— una TABLA DE DECISIÓN que la home no tiene. La intención de búsqueda
// de "qué mosquitero necesito" no se resuelve con una vitrina; se resuelve
// diciendo cuál va con cada ventana. Sin ese bloque, esta página sería la home
// con más tarjetas: contenido duplicado compitiendo consigo mismo.
//
// SEO — keyword-first (regla del portafolio):
//   • "tipos de mosquiteros" abre el title y la description (la home se queda
//     con "mosquiteros para ventanas" y /para-puertas/ con "mosquiteros para
//     puertas": una intención por URL, sin canibalizarse).
//   • Un solo H1 (el Hero). Las secciones abren en H2; los "a fondo" en H3.
//   • FAQ propia de catálogo, DISTINTA de la home: repetir sus 5 preguntas aquí
//     sería el mismo FAQPage dos veces, y Google elige una y descarta la otra.
//     Éstas responden a la intención de catálogo: cuál elijo, qué malla, medidas.
//   • El JSON-LD FAQPage lo emite lib/seo.ts vía schemaData — <FAQAccordion> va
//     SIN `emitSchema` (anti-patrón B3: doble FAQPage).
//   • CollectionPage + ItemList con los 7 tipos, apuntando a sus fichas reales.
//
// ⚠️ ESTADO: 🟢 Frank confirmó (2026-07-14) que se fabrican los 6 tipos y se
// venden accesorios. NO están validados materiales, medidas máximas, mallas en
// stock ni precios — por eso NADA aquí los afirma. Ver docs/GATE-LANZAMIENTO.md.
// ============================================================================
import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/Hero.astro";
import SectionMenu from "@components/SectionMenu.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CategoryCard from "@components/CategoryCard.astro";
import CategoryDetail from "@components/CategoryDetail.astro";
import MarcadoresGrid from "@components/MarcadoresGrid.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import QuoteForm from "@components/QuoteForm.astro";
import { anchorText } from '@config/anchors';
import { getCollection } from "astro:content";
import {
  PRODUCT_CATEGORIES,
  WA_MESSAGES,
  waUrl,
} from "@config/site";
import {
  ALCANCE_PRECIOS_REFERENCIA,
  PRECIOS_REFERENCIA,
  TAMANO_REFERENCIA,
  formatearPrecio,
  precioMasBajo,
} from "@config/precios";

const showcase = (await getCollection("productos"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);

const title = "Tipos de mosquiteros para ventanas y puertas | a medida";
const description =
  `Tipos de mosquiteros: enrollable, corredizo, abatible, plisado, magnético y fijo para ventanas y puertas a medida, en CDMX y Edomex desde ${formatearPrecio(precioMasBajo("ventana"))}.`;

const precioDeCategoria = (slug: string) => {
  const precio = PRECIOS_REFERENCIA[slug as keyof typeof PRECIOS_REFERENCIA];
  if (!precio || slug === "cambioDeMalla") return undefined;
  const referencias = [
    precio.ventana === null ? null : `Ventana desde ${formatearPrecio(precio.ventana)}`,
    precio.puerta === null ? null : `Puerta desde ${formatearPrecio(precio.puerta)}`,
  ].filter((referencia): referencia is string => referencia !== null);
  return referencias.join(" · ");
};

const precioTabla = (precio: number | null) => precio === null ? "—" : formatearPrecio(precio);

const incluidos = [
  { titulo: "A la medida de tu vano", texto: "Cada pieza se arma con las medidas exactas de tu ventana o puerta. No vendemos medidas de línea." },
  { titulo: "Instalación incluida", texto: "El precio de referencia ya incluye la instalación en CDMX y el Estado de México." },
  { titulo: "Malla según tu caso", texto: "Estándar, reforzada si hay mascotas o de trama cerrada para insecto pequeño." },
  { titulo: "Reparación y refacciones", texto: `Si el marco aguanta, se cambia solo la malla desde ${formatearPrecio(PRECIOS_REFERENCIA.cambioDeMalla.ventana)} por hoja.` },
];

// ── Barra bajo el hero ───────────────────────────────────────────────────────
// NO se copia el menú de la home: ésta es la sección Mosquiteros, así que su
// propia entrada sobra. Se enlazan las hermanas. Mismo criterio que la home
// («el hero presenta, la franja convierte»): el último botón es el CTA.
const menuSecciones = [
  { label: anchorText("/servicios/"), href: "/servicios/", sub: "Fabricación, instalación y reparación" },
  { label: anchorText("/cobertura/"), href: "/cobertura/", sub: "Zonas que atendemos" },
  { label: anchorText("/contacto/"), href: "/contacto/", sub: "Teléfono, WhatsApp y correo" },
  { label: anchorText("/blog/"), href: "/blog/", sub: "Guías y mantenimiento" },
];
const menuCta = {
  label: "Cotizar por WhatsApp",
  href: waUrl(WA_MESSAGES.productos ?? WA_MESSAGES.cotizar),
  sub: "Mándanos tus medidas",
  external: true,
};

// ── Menú de guías (antes del footer) ─────────────────────────────────────────
// Mismo patrón que la home: enlaza SOLO a artículos que existen. Aquí se eligen
// los de intención de catálogo, no los mismos 4 de la home — un menú idéntico en
// las dos páginas no aporta enlazado nuevo, solo repite.
const menuGuias = [
  { label: anchorText("/blog/tipos-de-mosquitero-cual-elegir/"), href: "/blog/tipos-de-mosquitero-cual-elegir/", sub: "Cuál va con tu ventana" },
  { label: anchorText("/blog/tipos-de-malla-mosquitero/"), href: "/blog/tipos-de-malla-mosquitero/", sub: "Cuál aguanta tu caso" },
  { label: anchorText("/blog/como-medir-ventana-mosquitero/"), href: "/blog/como-medir-ventana-mosquitero/", sub: "Toma bien las medidas del vano" },
  { label: anchorText("/blog/reparar-o-reponer-un-mosquitero/"), href: "/blog/reparar-o-reponer-un-mosquitero/", sub: "Cuándo conviene cada uno" },
];
const menuGuiasCta = {
  label: anchorText('/blog/'),
  href: "/blog/",
  sub: "Guías y mantenimiento",
  icon: "arrow" as const,
};

// ── Tabla de decisión — lo que esta L2 aporta y la home no ───────────────────
// 🟠 Conocimiento general del oficio, NO especificaciones del cliente. Dice qué
// tipo va con qué ventana; no dice medidas máximas, materiales ni precios.
// La columna "Piénsalo si…" no es un pero de cortesía: es lo que hace útil la
// tabla. Un catálogo donde todo sirve para todo no ayuda a decidir.
const decision: { tipo: string; slug: Exclude<keyof typeof PRECIOS_REFERENCIA, "cambioDeMalla">; abre: string; vaCon: string; piensaloSi: string }[] = [
  {
    tipo: "Enrollable",
    slug: "enrollables",
    abre: "La malla sube y baja desde un cajón superior",
    vaCon: "Ventana de uso diario donde quieres que la malla desaparezca",
    piensaloSi: "No hay unos centímetros libres arriba del vano para el cajón",
  },
  {
    tipo: "Corredizo",
    slug: "corredizos",
    abre: "Corre de lado sobre su propio riel",
    vaCon: "Ventana o puerta corrediza que ya corre sobre riel",
    piensaloSi: "Tu ventana no es corrediza: no hay riel donde montarlo",
  },
  {
    tipo: "Abatible",
    slug: "abatibles",
    abre: "Abre como puerta, sobre bisagras",
    vaCon: "Puerta de acceso por la que entras y sales todo el día",
    piensaloSi: "El espacio no deja abrir una hoja hacia fuera o hacia dentro",
  },
  {
    tipo: "Plisado",
    slug: "plisados",
    abre: "Se pliega en acordeón a un costado",
    vaCon: "Vano amplio o puerta de cristal que otros tipos no cubren",
    piensaloSi: "El vano es pequeño: un corredizo sale más simple y económico",
  },
  {
    tipo: "Magnético",
    slug: "magneticos",
    abre: "Cortina que se cierra sola con imanes",
    vaCon: "Puerta por la que pasas con las manos ocupadas",
    piensaloSi: "Es una ventana: está pensado para pasar a través",
  },
  {
    tipo: "Fijo",
    slug: "fijos",
    abre: "No abre: bastidor fijo al marco",
    vaCon: "Ventana de poco uso, cubo de luz, ventana alta",
    piensaloSi: "Necesitas asomarte o limpiar el cristal seguido",
  },
];

// ── FAQ de catálogo ──────────────────────────────────────────────────────────
// DISTINTAS de las de la home a propósito: dos FAQPage con las mismas preguntas
// compiten entre sí y Google descarta una. Éstas responden a la intención de
// quien está eligiendo tipo, no a la de quien acaba de aterrizar.
// 🟠 Sin validar. Cero precios, plazos y garantías (nadie los ha confirmado).
const faqs: { question: string; answer: string }[] = [
  {
    question: "¿Cuántos tipos de mosquiteros hay?",
    answer:
      "Para ventanas y puertas hay seis: <strong>enrollable</strong> (la malla se recoge en un cajón), <strong>corredizo</strong> (corre sobre riel), <strong>abatible</strong> (abre sobre bisagras), <strong>plisado</strong> (se pliega en acordeón), <strong>magnético</strong> (cortina que se cierra con imanes) y <strong>fijo</strong> (no abre). Cuál te conviene lo decide el marco que ya tienes y el uso que le das a esa ventana.",
  },
  {
    question: "¿Cuál es el mejor tipo de mosquitero para ventana?",
    answer:
      "No hay uno mejor para todas: el mejor es el que encaja con tu marco. En una ventana corrediza, el corredizo es el más simple; si quieres que la malla desaparezca cuando no la usas, el enrollable; si la ventana casi no se abre, el fijo cuesta menos y no tiene mecanismo que falle. Con una foto de la ventana completa sabemos cuál es el tuyo.",
  },
  {
    question: "¿Qué tipo de mosquitero necesito para mi ventana?",
    answer:
      "Lo define el marco que ya tienes, no el gusto. Si tu ventana <strong>corre sobre riel</strong>, va un corredizo. Si es una <strong>puerta de acceso diario</strong>, un abatible o un magnético. Si quieres que la malla <strong>desaparezca</strong> cuando no la usas, un enrollable. Si el vano es <strong>amplio o de cristal</strong>, un plisado. Y si la ventana <strong>casi no se abre</strong>, un fijo resuelve por mucho menos. Mándanos una foto de la ventana completa y te decimos cuál es el tuyo.",
  },
  {
    question: "¿Puedo poner un enrollable en cualquier ventana?",
    answer:
      "No siempre. El enrollable necesita <strong>unos centímetros libres arriba del vano</strong> para el cajón donde se recoge la malla. Si ese espacio no existe —porque hay una cortina, un domo o el marco llega al techo— no entra, y forzarlo deja el cajón a la vista o el mosquitero sin cerrar completo. En ese caso te proponemos otro tipo antes de fabricar, no después.",
  },
  {
    question: "¿Qué malla me conviene?",
    answer:
      "Depende del caso, no del tipo de mosquitero: la <strong>misma pieza admite mallas distintas</strong>. Si hay mascotas conviene una malla reforzada que aguante el rasguño; si pega el sol, una que filtre; si el problema son insectos muy chicos, una de trama más cerrada. Cuéntanos qué te pasa en esa ventana y te decimos cuál corresponde. Lo explicamos a fondo en <a href=\"/blog/tipos-de-malla-mosquitero/\">tipos de malla</a>.",
  },
  {
    question: "¿Todos se fabrican a la medida?",
    answer:
      "Sí. No trabajamos medidas de línea: cada pieza se arma a las <strong>dimensiones exactas de tu vano</strong>. Es lo que hace que cierre completo, sin huecos por donde se cuele un mosquito. Por eso necesitamos las medidas antes de cotizar — o vamos nosotros a tomarlas.",
  },
  {
    question: "¿Solo se me rompió la malla, tengo que cambiar el mosquitero entero?",
    answer:
      "Casi nunca. Si el <strong>bastidor y los herrajes aguantan</strong>, se cambia solo la tela y queda como nuevo por una fracción de lo que cuesta una pieza nueva. Cuando el marco está vencido o los rodamientos ya no corren, te lo decimos con franqueza — aunque signifique no vender la reparación. También vendemos <a href=\"/mosquiteros/accesorios/\">malla y refacciones por separado</a> si reparas por tu cuenta.",
  },
  {
    question: "¿Qué tipos de tela mosquitera existen?",
    answer:
      "Las más comunes son la malla de <strong>fibra de vidrio</strong>, la estándar para insecto común; la <strong>reforzada</strong> para mascotas, más resistente al rasguño; la de <strong>trama cerrada</strong> para insectos muy pequeños, y las <strong>metálicas</strong>, de aluminio o acero inoxidable, para golpes y uso rudo. La misma pieza admite cualquiera: se elige por lo que pasa en esa ventana.",
  },
  {
    question: "¿Qué mosquitero es más fácil de instalar?",
    answer:
      "El <strong>magnético</strong>: se fija al marco con cinta o tachuelas, sin obra ni bastidor. Le sigue el <strong>fijo</strong>, que se monta al vano sin mecanismo. Los que llevan riel, cajón o bisagras —corredizo, enrollable, abatible y plisado— piden más ajuste, y por eso conviene que los instale quien los fabricó a la medida.",
  },
  {
    question: "¿Cuánto cuesta un mosquitero?",
    answer:
      `Con fabricación a medida e instalación en CDMX y Edomex, una ventana va desde <strong>${formatearPrecio(precioMasBajo("ventana"))}</strong> y una puerta desde <strong>${formatearPrecio(precioMasBajo("puerta"))}</strong>. El precio final depende de tres cosas: las <strong>medidas del vano</strong>, el <strong>tipo</strong> y la <strong>malla</strong>. La comparativa de arriba da el «desde» de cada tipo para una ventana de hasta 1.00 × 1.20 m. Con tus medidas por WhatsApp calculamos el precio de tu caso. De qué depende, a fondo, en <a href="/blog/de-que-depende-el-precio-de-un-mosquitero/">esta guía</a>.`,
  },
];
---

<PageLayout
  title={title}
  description={description}
  pageType="category"
  breadcrumbs={[{ label: "Inicio", href: "/" }, { label: "Mosquiteros" }]}
  schemaData={{
    // CollectionPage + ItemList con los 7 tipos → sus fichas reales (vía
    // productoHref, el interruptor de site.ts). El LocalBusiness sale del grafo
    // base de lib/seo.ts; NO se emite aquí (anti-patrón B3: doble entidad).
    list: {
      name: "Tipos de mosquitero — Mosquitero.mx",
      description,
      path: "/mosquiteros/",
      items: PRODUCT_CATEGORIES.map((c) => ({
        name: c.label,
        path: c.href,
        description: c.desc,
      })),
    },
    // El FAQPage lo arma seo.ts desde aquí. <FAQAccordion> va sin `emitSchema`.
    faqs,
  }}
>
  {/* ═══ 1) HERO — H1 único. Las secciones de abajo abren en H2. ═══ */}
  <Hero
    title="Tipos de mosquiteros para cada"
    accent="ventana"
    subtitle={`Seis tipos a medida —enrollable, corredizo, abatible, plisado, magnético y fijo— con instalación en CDMX y Edomex desde ${formatearPrecio(precioMasBajo("ventana"))}. Te decimos cuál va con tu ventana antes de que pidas la pieza equivocada.`}
    descRight={[
      "El tipo correcto no lo eliges por gusto: lo define el marco que ya tienes y el uso que le das a esa ventana. Un corredizo no entra donde no hay riel, y un enrollable necesita espacio arriba del vano para su cajón. Por eso este catálogo dice, en cada tipo, con qué ventana va — y con cuál no.",
      "Todos se fabrican a la medida exacta de tu vano y los instalamos nosotros. Si tu ventana no encaja claro en ninguno, mándanos una foto por WhatsApp: con verla sabemos cuál corresponde.",
    ]}
  />

  {/* ═══ MENÚ DE SECCIONES — barra full-width bajo el hero ═══ */}
  <SectionMenu items={menuSecciones} cta={menuCta} ariaLabel="Secciones del sitio" />

  {/* ═══ 2) VITRINA — los 7 tipos (la home solo muestra 4: SHOWCASE_HOME) ═══ */}
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Catálogo"
        title="Los seis tipos de mosquitero"
        body={[
          "Hay seis tipos de mosquitero a medida: enrollable, corredizo, abatible, plisado, magnético y fijo. Cada uno resuelve un caso distinto: el enrollable esconde la malla, el corredizo aprovecha el riel que ya tienes, el abatible aguanta el paso diario, el plisado cubre vanos amplios, el magnético se abre al pasar y el fijo protege ventanas que casi no se abren.",
          "Además vendemos malla, perfiles y herrajes por separado para quien repara por su cuenta. Entra a cualquier tipo para ver cómo funciona y en qué ventana encaja.",
        ]}
      />
      <div class="showcase">
        {showcase.map((cat, i) => (
          <CategoryCard
            label={cat.label}
            href={cat.href}
            image={cat.image}
            imageAlt={cat.imageAlt}
            badge={cat.badge}
            blurb={cat.blurb}
            subcategories={cat.subcategories}
            ctaLabel={anchorText(cat.href)}
            index={i}
            precio={precioDeCategoria(cat.category)}
            variant={cat.category === "accesorios" ? "wide" : undefined}
          />
        ))}
      </div>
      <p class="showcase-links"><a href="/mosquiteros/para-puertas/">{anchorText('/mosquiteros/para-puertas/')}</a> · <a href="/mosquiteros/para-ventanas-de-aluminio/">{anchorText('/mosquiteros/para-ventanas-de-aluminio/')}</a> · <a href="/mosquiteros/magneticos/">{anchorText('/mosquiteros/magneticos/', { variante: 0 })}</a></p>
    </div>
  </section>

  {/* ═══ 3) CÓMO ELEGIR — el bloque que justifica esta L2 ═══════════════════
      Sin esto, la página sería la home con más tarjetas: mismo contenido
      compitiendo consigo mismo por la misma búsqueda. La intención de "qué
      mosquitero necesito" se resuelve aquí, no en una vitrina.
      La columna "Piénsalo si…" es la que da confianza: un catálogo donde todo
      sirve para todo no ayuda a nadie a decidir. ══════════════════════════ */}
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Cómo elegir"
        title="Qué tipo de mosquitero es mejor para tu ventana"
        body={[
          "Esta es la tabla que usamos nosotros cuando nos mandas una foto. Busca tu caso en la columna del medio: casi siempre hay un solo tipo que encaja, y los demás quedan descartados por el marco que ya tienes.",
          "La última columna es igual de importante. Decimos cuándo un tipo NO conviene porque preferimos que no compres la pieza equivocada — devolver un mosquitero a medida no es una opción para nadie.",
        ]}
      />

      <div class="tabla-wrap">
        <table class="tabla">
          <caption class="tabla__caption">
            Comparativa de tipos de mosquitero: cómo abre, con qué ventana va y precio de referencia
          </caption>
          <thead>
            <tr>
              <th scope="col">Tipo</th>
              <th scope="col">Cómo abre</th>
              <th scope="col">Va con…</th>
              <th scope="col">Piénsalo si…</th>
              <th scope="col" class="tabla__precio-col">Ventana desde</th>
              <th scope="col" class="tabla__precio-col">Puerta desde</th>
            </tr>
          </thead>
          <tbody>
            {decision.map((d) => (
              <tr>
                <th scope="row" class="tabla__tipo">
                  <a href={`/mosquiteros/${d.slug}/`}>{d.tipo}</a>
                </th>
                <td>{d.abre}</td>
                <td>{d.vaCon}</td>
                <td class="tabla__pero">{d.piensaloSi}</td>
                <td class="tabla__precio">{precioTabla(PRECIOS_REFERENCIA[d.slug].ventana)}</td>
                <td class="tabla__precio">{precioTabla(PRECIOS_REFERENCIA[d.slug].puerta)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="tabla__nota">
        {TAMANO_REFERENCIA}
      </p>
      <p class="tabla__nota">
        {ALCANCE_PRECIOS_REFERENCIA}
      </p>
      <p class="tabla__nota">
        Cambio de malla desde {formatearPrecio(PRECIOS_REFERENCIA.cambioDeMalla.ventana)} por hoja de ventana: <a href="/servicios/reparacion/">reparación</a>.
      </p>
      <p class="tabla__nota">
        ¿Sigues sin verlo claro? Es lo más normal — casi nadie llega sabiendo si
        su ventana pide un corredizo o un enrollable. Mándanos una foto de la
        ventana completa y te lo decimos nosotros.
      </p>
      <p class="tabla__nota">
        ¿Es para una puerta? Revisa <a href="/mosquiteros/para-puertas/">qué mosquitero corresponde a cada tipo de puerta</a>.
      </p>
    </div>
  </section>

  {/* ═══ 4) CADA TIPO, A FONDO ══════════════════════════════════════════════
      Mismo patrón que la home: se recorre SHOWCASE y se filtra por AFONDO[slug],
      así una categoría sin entrada en AFONDO no rompe la sección.
      as="h3" NO es opcional: estos bloques cuelgan del H2 de esta sección. Con
      el h2 por defecto del componente saldrían siete H2 bajo otro H2 — un salto
      de jerarquía hacia arriba. Regla: H2 sección padre → H3 sub-bloque.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="section seccion-afondo">
    <div class="container">
      <SectionHeading
        eyebrow="A fondo"
        title="Cómo funcionan los tipos de mosquiteros"
        body={[
          "Aquí se amplía lo de arriba sin obligarte a entrar a otra página: cómo trabaja cada mecanismo, qué caso resuelve y qué condición pide del vano.",
          "Si prefieres el detalle completo de un tipo —con su galería y sus puntos— entra a su ficha desde el botón de cada bloque.",
        ]}
      />
      <div class="afondo bandas-alternas">
        {showcase.map((cat) => (
          <CategoryDetail
            id={`afondo-${cat.category}`}
            as="h3"
            eyebrow="El tipo a fondo"
            title={cat.label}
            body={cat.body}
            points={cat.points}
            gallery={cat.gallery}
            cta={{ label: anchorText(cat.href), href: cat.href }}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mint">
    <div class="container">
      <SectionHeading
        eyebrow="Incluido"
        title="Lo que lleva cada mosquitero"
        layout="simple"
        desc="Cambie el tipo, el trabajo es el mismo: medimos, fabricamos a la medida exacta del vano, instalamos y revisamos que cierre completo."
      />
